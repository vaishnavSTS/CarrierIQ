# Copy to backend/.env (used by local runs and by Docker Compose). Never commit real .env files.

# PostgreSQL (used by docker-compose)
POSTGRES_USER=carrieriq
POSTGRES_PASSWORD=carrieriq
POSTGRES_DB=carrieriq

# Backend database (Supabase). Use the "Session pooler" connection string from
# Supabase -> Connect, change the prefix to postgresql+psycopg:// and add ?sslmode=require.
# URL-encode special characters in the password (@ -> %40, # -> %23, etc.).
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Local Postgres alternative for local runs (Docker: use docker-compose.localdb.yml instead):
# DATABASE_URL=postgresql+psycopg://carrieriq:carrieriq@localhost:5432/carrieriq
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Optional: data.transportation.gov app token (higher rate limits)
SOCRATA_APP_TOKEN=

# Optional: FMCSA QCMobile WebKey (free, from mobile.fmcsa.dot.gov/QCDevsite). Adds each
# carrier's EIN to the Identity and Chameleon check tabs. A secret: never commit it.
QCMOBILE_WEB_KEY=

# DataQs evidence files (docs/DataQ.md): a private Supabase Storage bucket over the S3 protocol
# (Supabase → Storage → S3 Configuration: endpoint, region, and a New access key). Secrets: never
# commit them, never put them in the frontend. Evidence uploads are refused while these are empty.
DATAQS_STORAGE_ENDPOINT=
DATAQS_STORAGE_REGION=us-east-1
DATAQS_STORAGE_ACCESS_KEY_ID=
DATAQS_STORAGE_SECRET_ACCESS_KEY=
DATAQS_STORAGE_BUCKET=dataqs-evidence

# DataQs emails through Resend (resend.com): emails to carriers and reminders to STS staff.
# Nothing is sent while RESEND_API_KEY is empty (emails wait). The FROM address must use a
# domain verified in Resend. A secret: never commit it.
RESEND_API_KEY=
DATAQS_EMAIL_FROM=Sky Transport Solutions <dataqs@skytransportsolutions.com>
DATAQS_EMAIL_REPLY_TO=Info@skytransportsolutions.com
PUBLIC_APP_URL=http://localhost:5173
# While testing: send every carrier / STS staff email to these addresses instead.
DATAQS_EMAIL_CARRIER_OVERRIDE=wesley@skytransportsolutions.com
DATAQS_EMAIL_STAFF_OVERRIDE=vaishnav@skytransportsolutions.com

# Login sessions. Required outside local development: a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_SECRET_KEY=

# Optional: "Continue with Google". From Google Cloud Console > Credentials > OAuth client
# (Web application). Authorized redirect URI: http://localhost:5173/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Local development: also run the background worker inside the backend, so starting the API
# starts both. Leave unset (false) when hosted; the worker then runs as its own service.
# RUN_WORKER_IN_API=true

# Clients see only their own carriers (default false). Set true to let them search and open
# any carrier, e.g. for STS team testing.
# CLIENT_SEARCH_ENABLED=true
